// ECS meshes: one draw call per mesh + material for every entity using them
// (GPU instancing). Each instance carries its world matrix (three rows) and a
// color. "lit": the main directional light and the ambient light; "unlit":
// texture × color only.
CCEffect %{
  techniques:
  - name: lit
    passes:
    - vert: mesh-vs:vert
      frag: mesh-fs:frag
      properties: &props
        mainTexture: { value: white }
        mainColor: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        alphaThreshold: { value: 0.0, editor: { slide: true, range: [0, 1, 0.01] } }
      embeddedMacros: &lit { USE_LIGHTING: true }
    - vert: mesh-vs:vert
      frag: mesh-fs:frag
      phase: deferred-forward
      propertyIndex: 0
      embeddedMacros: *lit
  - name: unlit
    passes:
    - vert: mesh-vs:vert
      frag: mesh-fs:frag
      properties: *props
    - vert: mesh-vs:vert
      frag: mesh-fs:frag
      phase: deferred-forward
      propertyIndex: 0
  - name: transparent
    passes:
    - vert: mesh-vs:vert
      frag: mesh-fs:frag
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties: *props
}%

CCProgram mesh-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec3 a_position;
  in vec3 a_normal;
  in vec2 a_texCoord;
  // Per instance: the world matrix as three rows, and a color.
  in vec4 a_inst0;
  in vec4 a_inst1;
  in vec4 a_inst2;
  in vec4 a_instColor;

  out vec3 v_normal;
  out vec2 v_uv;
  out vec4 v_color;

  vec4 vert () {
    vec4 p = vec4(a_position, 1.0);
    vec3 world = vec3(dot(a_inst0, p), dot(a_inst1, p), dot(a_inst2, p));
    v_normal = vec3(dot(a_inst0.xyz, a_normal), dot(a_inst1.xyz, a_normal), dot(a_inst2.xyz, a_normal));
    v_uv = a_texCoord;
    v_color = a_instColor;
    return cc_matProj * (cc_matView * vec4(world, 1.0));
  }
}%

CCProgram mesh-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>

  in vec3 v_normal;
  in vec2 v_uv;
  in vec4 v_color;

  uniform sampler2D mainTexture;

  uniform Constant {
    vec4 mainColor;
    float alphaThreshold;
  };

  vec4 frag () {
    vec4 tex = texture(mainTexture, v_uv);
    tex.rgb = SRGBToLinear(tex.rgb);
    vec4 o = mainColor * tex;
    o.rgb *= SRGBToLinear(v_color.rgb);
    o.a *= v_color.a;
    if (o.a < alphaThreshold) discard;
    #if USE_LIGHTING
      vec3 N = normalize(v_normal);
      vec3 L = normalize(-cc_mainLitDir.xyz);
      float ndl = max(dot(N, L), 0.0);
      vec3 sky = cc_ambientSky.rgb * cc_ambientSky.w;
      vec3 ground = cc_ambientGround.rgb * cc_ambientSky.w;
      vec3 ambient = mix(ground, sky, N.y * 0.5 + 0.5);
      vec3 light = cc_mainLitColor.rgb * cc_mainLitColor.w * ndl;
      o.rgb *= (ambient + light) * cc_exposure.x;
    #endif
    return CCFragOutput(o);
  }
}%
